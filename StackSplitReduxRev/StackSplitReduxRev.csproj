<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>StackSplitReduxRev</RootNamespace>
    <AssemblyName>StackSplitReduxRev</AssemblyName>
    <Version>0.14.5.00</Version>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
    <NoWarn>CS9057</NoWarn>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableModDeploy>false</EnableModDeploy>
    <EnableModZip>true</EnableModZip>
    <ModFolderName>StackSplitReduxRev</ModFolderName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="manifest.json" Pack="true" PackagePath="" />
    <None Include="i18n\default.json" Pack="true" PackagePath="" />
    <None Include="i18n\zh.json" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
